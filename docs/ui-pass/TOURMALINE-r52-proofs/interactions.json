    {
      "scene": "rest",
      "size": [
        1280,
        800
      ],
      "targets": [
        {
          "text": "1\n        \n        \n          Rest\n          Take a nap while your Companion keeps watch.\n          Courage 46 \u2192 68\n          Recovers up to 22.\n        ",
          "disabled": false,
          "hit": true,
          "font": "20px",
          "focus": true
        },
        {
          "text": "2\n        \n        \n          Sharpen a Trick\n          Work on one Trick by torchlight until it is better than it was.\n          14 Tricks can be sharpened\n          Permanent, for the rest of the expedition.\n        ",
          "disabled": false,
          "hit": true,
          "font": "20px",
          "focus": true
        },
        {
          "text": "3\n        \n        \n          Forge a Keepsake\n          The flame strengthens a Keepsake. Its price is some of your maximum Courage.\n          Costs 8 maximum Courage\n          Courage 74 \u2192 66 \u00b7 the Keepsake fires twice\n        ",
          "disabled": false,
          "hit": true,
          "font": "20px",
          "focus": true
        },
        {
          "text": "4\n        \n        \n          Sit with your Companion\n          Share a quiet moment and see what catches their attention.\n          +1 Clue\n          Spend your fort action to gain a Clue.\n        ",
          "disabled": false,
          "hit": true,
          "font": "20px",
          "focus": true
        }
      ],
